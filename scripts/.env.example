# Copy this file to `.env` (same folder) and fill in real values.
# .env is already in .gitignore — never commit real credentials.

DEVELOPER_TOKEN=
REFRESH_TOKEN=
MANAGER_CUSTOMER_ID=
VERTEX_CUSTOMER_ID=

# Added for sync_leads.py — service role key (Project Settings -> API ->
# service_role) bypasses RLS; this script is the only thing that should
# ever use it. Never expose this key to a frontend/browser context.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Added for send_alerts.py
RESEND_API_KEY=
